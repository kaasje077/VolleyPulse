@page
@model UI.Pages.Schedule.DetailsModel

<div class="container mt-4">

    <div class="card shadow">

        <div class="schedule-card-header">
            <h2>Event Details</h2>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <strong>Date:</strong>
                @Model.Practice.date.ToString("dd/MM/yyyy")
            </div>

            <div class="mb-3">
                <strong>Time:</strong>
                @Model.Practice.startTime.ToString(@"hh\:mm") - @Model.Practice.endTime.ToString(@"hh\:mm")
            </div>

            <div class="mb-3">
                <strong>Location:</strong>
                @Model.Practice.location
            </div>

            @if (!string.IsNullOrEmpty(Model.Practice.notes))
            {
                <div class="mb-3">
                    <strong>Notes:</strong>
                    @Model.Practice.notes
                </div>
            }

            @{
                DateTime eventDateTime =
                    Model.Practice.date.Date + Model.Practice.startTime;
            }

            <h4>Attendance</h4>

            @if (HttpContext.Session.GetString("MemberRole") != "Coach")
            {
                if (Model.Attendance != null)
                {
                    <div class="alert alert-info">
                        You have marked your attendance as
                        <strong>@Model.Attendance.Status</strong>.
                    </div>
                }
                else if (eventDateTime > DateTime.Now)
                {
                    <form method="post"
                          asp-page="/Teams/Member/Player/MarkAttendance"
                          asp-page-handler="Present"
                          class="d-inline">

                        <input type="hidden" name="id" value="@Model.Practice.id" />

                        <button type="submit" class="btn btn-success me-2">
                            Present
                        </button>
                    </form>

                    <form method="post"
                          asp-page="/Teams/Member/Player/MarkAttendance"
                          asp-page-handler="Absent"
                          class="d-inline">

                        <input type="hidden" name="id" value="@Model.Practice.id" />

                        <button type="submit" class="btn btn-danger">
                            Absent
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-secondary">
                        Attendance can no longer be adjusted for this event.
                    </div>
                }
            }

        </div>
    </div>
</div>